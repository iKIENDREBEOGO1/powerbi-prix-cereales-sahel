/// Les 4 pays suivis.
table Pays
	lineageTag: bc06b49e-b11d-4c14-abe9-40032be0e1a6

	/// Code pays
	column 'Code pays'
		dataType: string
		isKey
		isHidden
		lineageTag: 8add70eb-65b0-47c5-afd7-1d9f5630ffc6
		summarizeBy: none
		sourceColumn: code_pays
	
		annotation SummarizationSetBy = Automatic
	
	/// Pays
	column Pays
		dataType: string
		lineageTag: fc9f4458-994b-4e69-a4fe-777b672a5e66
		dataCategory: Country
		summarizeBy: none
		sourceColumn: pays
		sortByColumn: 'Ordre pays'
	
		annotation SummarizationSetBy = Automatic
	
	/// Ordre pays
	column 'Ordre pays'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 664d988a-c348-44e2-abe4-fe508a383eb2
		summarizeBy: none
		sourceColumn: ordre_pays
	
		annotation SummarizationSetBy = Automatic
	
	partition Pays = m
		mode: import
		source =
				let
				    // Lecture du CSV produit par scripts/preparer_donnees.py
				    Source = Csv.Document(File.Contents(#"Dossier données" & "pays.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    #"Promoted headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    #"Changed types" = Table.TransformColumnTypes(#"Promoted headers", {{"ordre_pays", Int64.Type}}, "en-US")
				in
				    #"Changed types"
	
